# Environment variables, documented. Copy to `.env.local` only if you need
# them locally; real values never go in Git (.gitignore covers `.env*`).
#
# Locally you usually need none of these: the backend uses your AWS profile
# (~/.aws/credentials) for Bedrock. On Vercel there is no profile, so set the
# two keys below in Project Settings -> Environment Variables. Use an IAM user
# that may only call bedrock:InvokeModelWithResponseStream (the chat streams)
# on the one model the site uses.

# Read only on Vercel (runtime.is_vercel()), by portfolio_ai/config.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional, read everywhere. Overrides the chat model (default: Nova Micro,
# us.amazon.nova-micro-v1:0); set it to a Claude Haiku inference profile ID
# to switch to Plan B without a code change.
CHAT_MODEL_ID=
